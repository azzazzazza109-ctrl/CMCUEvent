@model List<Category>
@{ ViewData["Title"]="Quản lý danh mục"; }
<div class="heading"><h1>Quản lý danh mục</h1><a asp-action="Create" class="button">+ Thêm danh mục</a></div>
@if(Model.Count==0) { <p class="empty">Chưa có danh mục.</p> }
else { <div class="table-wrap"><table><thead><tr><th>Tên danh mục</th><th>Mô tả</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var c in Model) { <tr><td>@c.Name</td><td>@c.Description</td><td><div class="actions"><a asp-action="Details" asp-route-id="@c.Id">Xem</a><a asp-action="Edit" asp-route-id="@c.Id">Sửa</a><a asp-action="Delete" asp-route-id="@c.Id">Xóa</a></div></td></tr> }
</tbody></table></div> }
