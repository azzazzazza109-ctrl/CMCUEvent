@model Category
@{ ViewData["Title"]="Xóa danh mục"; }
<section class="panel form-panel"><h1>Xóa danh mục</h1><p>Bạn muốn xóa <strong>@Model.Name</strong>?</p><p class="muted">Không thể xóa nếu còn sự kiện thuộc danh mục này.</p><form asp-action="Delete" asp-route-id="@Model.Id" method="post"><button type="submit" class="button danger">Xác nhận xóa</button> <a class="button secondary" asp-action="Index">Quay lại</a></form></section>
