@model List<Registration>
@{ ViewData["Title"]="Sự kiện đã đăng ký"; }
<h1>Sự kiện đã đăng ký</h1><p class="muted">Theo dõi lịch sử đăng ký và hủy tham gia.</p>
@if (Model.Count==0) { <p class="empty">Bạn chưa đăng ký sự kiện nào. <a asp-controller="Events" asp-action="Index">Khám phá sự kiện</a></p> }
else { <div class="table-wrap registration-table" tabindex="0" role="region" aria-label="Bảng lịch sử đăng ký"><table><thead><tr><th>Sự kiện</th><th>Thời gian bắt đầu</th><th>Ngày đăng ký</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var r in Model) { <tr><td><a asp-controller="Events" asp-action="Details" asp-route-id="@r.EventId">@r.Event.Name</a></td><td>@r.Event.StartTime.ToString("dd/MM/yyyy HH:mm")</td><td>@r.RegisteredAt.ToString("dd/MM/yyyy HH:mm")</td><td>@(r.Status=="Cancelled" ? "Đã hủy" : "Đã đăng ký")</td><td>
@if(r.Status=="Registered" && r.Event.StartTime>DateTime.Now) { <form asp-action="Cancel" asp-route-id="@r.Id" method="post" data-confirm="Bạn chắc chắn muốn hủy đăng ký?"><button class="button danger" type="submit">Hủy đăng ký</button></form> }
else { <span class="muted">—</span> }
</td></tr> }
</tbody></table></div> }
