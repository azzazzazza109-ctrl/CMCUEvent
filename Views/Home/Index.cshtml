@model List<Event>
@{ ViewData["Title"] = "Trang chủ"; }
<section class="hero">
    <p class="eyebrow">CỘNG ĐỒNG SINH VIÊN</p>
    <h1>Khám phá sự kiện.<br />Kết nối và trải nghiệm.</h1>
    <p>Tìm kiếm hội thảo, hoạt động thể thao, văn nghệ và cuộc thi. Đăng ký tham gia ngay trên website.</p>
    <a class="button light" asp-controller="Events" asp-action="Index">Khám phá sự kiện</a>
</section>
<div class="heading"><div><p class="eyebrow">LỊCH HOẠT ĐỘNG</p><h2>Sự kiện gần nhất</h2></div><a asp-controller="Events" asp-action="Index">Xem tất cả →</a></div>
@if (Model.Count == 0) { <p class="empty">Chưa có sự kiện sắp tới.</p> }
<div class="event-grid">@foreach(var e in Model) { <partial name="_EventCard" model="e" /> }</div>
