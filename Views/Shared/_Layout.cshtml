<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CMCU Event</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="header">
    <div class="container nav">
        <a class="brand" asp-controller="Home" asp-action="Index"><img src="~/images/logo.png" alt="" /> CMCU <span>EVENT</span></a>
        <button type="button" id="menu-button" class="menu-button" aria-controls="main-nav" aria-expanded="false">Menu</button>
        <nav id="main-nav" aria-label="Điều hướng chính">
            <a asp-controller="Home" asp-action="Index">Trang chủ</a>
            <a asp-controller="Events" asp-action="Index">Sự kiện</a>
            @if (User.IsInRole("User")) { <a asp-controller="Registrations" asp-action="Index">Đã đăng ký</a> }
            @if (User.IsInRole("Admin")) {
                <a asp-controller="AdminEvents" asp-action="Index">Quản lý sự kiện</a>
                <a asp-controller="Categories" asp-action="Index">Danh mục</a>
            }
            @if (User.Identity?.IsAuthenticated == true) {
                <span class="nav-user">@User.Identity.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post"><button class="button secondary" type="submit">Đăng xuất</button></form>
            } else {
                <a asp-controller="Account" asp-action="Login">Đăng nhập</a>
                <a class="button" asp-controller="Account" asp-action="Register">Đăng ký</a>
            }
        </nav>
    </div>
</header>
<main class="container main-content">
    @if (TempData["Success"] is string success) { <div class="notice success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="notice error" role="alert">@error</div> }
    @RenderBody()
</main>
<footer class="footer"><div class="container">CMCU Event · Website quản lý sự kiện sinh viên · PROG2008</div></footer>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
