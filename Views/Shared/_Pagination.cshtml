@model EventListViewModel
@if (Model.TotalPages > 1) {
    <nav class="pagination" aria-label="Phân trang">
        @if (Model.CurrentPage > 1) { <a asp-action="Index" asp-route-page="@(Model.CurrentPage-1)" asp-route-keyword="@Model.Keyword" asp-route-categoryId="@Model.CategoryId">Trước</a> }
        <span>Trang @Model.CurrentPage / @Model.TotalPages</span>
        @if (Model.CurrentPage < Model.TotalPages) { <a asp-action="Index" asp-route-page="@(Model.CurrentPage+1)" asp-route-keyword="@Model.Keyword" asp-route-categoryId="@Model.CategoryId">Sau</a> }
    </nav>
}
