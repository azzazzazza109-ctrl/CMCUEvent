@model Event
<article class="event-card">
    <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.Id"><img src="@Model.ImagePath" alt="Ảnh sự kiện @Model.Name" /></a>
    <div class="card-body">
        <span class="tag">@Model.Category.Name</span><span class="tag status">@Model.DisplayStatus</span>
        <h3><a asp-controller="Events" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a></h3>
        <p>@Model.StartTime.ToString("dd/MM/yyyy HH:mm")</p>
        <p>@Model.Location</p>
        <p><strong>@Model.Remaining</strong> / @Model.MaxParticipants chỗ còn lại</p>
        <a class="button secondary" asp-controller="Events" asp-action="Details" asp-route-id="@Model.Id">Xem chi tiết</a>
    </div>
</article>
