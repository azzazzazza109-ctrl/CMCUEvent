@model Event
@{ ViewData["Title"]="Chi tiết quản trị"; }
<a asp-action="Index">← Quản lý sự kiện</a><h1>@Model.Name</h1><div class="details"><img class="detail-image" src="@Model.ImagePath" alt="Ảnh sự kiện" /><div class="panel"><dl><dt>Danh mục</dt><dd>@Model.Category.Name</dd><dt>Địa điểm</dt><dd>@Model.Location</dd><dt>Bắt đầu</dt><dd>@Model.StartTime.ToString("dd/MM/yyyy HH:mm")</dd><dt>Kết thúc</dt><dd>@Model.EndTime.ToString("dd/MM/yyyy HH:mm")</dd><dt>Trạng thái</dt><dd>@Model.DisplayStatus</dd><dt>Đăng ký</dt><dd>@Model.RegisteredCount / @Model.MaxParticipants</dd></dl><p class="description">@Model.Description</p><div class="actions"><a class="button" asp-action="Edit" asp-route-id="@Model.Id">Sửa</a><a class="button secondary" asp-action="Participants" asp-route-id="@Model.Id">Người tham gia</a></div></div></div>
