@model EventForm
<div asp-validation-summary="All" class="validation"></div>
<label asp-for="Name">Tên sự kiện</label><input asp-for="Name" required maxlength="200" /><span asp-validation-for="Name" class="validation"></span>
<label asp-for="CategoryId">Danh mục</label><select asp-for="CategoryId" asp-items="ViewBag.Categories" required><option value="">-- Chọn danh mục --</option></select><span asp-validation-for="CategoryId" class="validation"></span>
<label asp-for="Description">Mô tả</label><textarea asp-for="Description" required rows="5"></textarea><span asp-validation-for="Description" class="validation"></span>
<div class="form-grid"><div><label asp-for="StartTime">Bắt đầu</label><input asp-for="StartTime" type="datetime-local" required /><span asp-validation-for="StartTime" class="validation"></span></div><div><label asp-for="EndTime">Kết thúc</label><input asp-for="EndTime" type="datetime-local" required /><span asp-validation-for="EndTime" class="validation"></span></div></div>
<p id="time-error" class="validation" role="alert"></p>
<label asp-for="Location">Địa điểm</label><input asp-for="Location" required maxlength="250" /><span asp-validation-for="Location" class="validation"></span>
<label asp-for="MaxParticipants">Số người tối đa</label><input asp-for="MaxParticipants" type="number" min="1" required /><span asp-validation-for="MaxParticipants" class="validation"></span>
<label asp-for="Image">Ảnh sự kiện (JPG/PNG, tối đa 2 MB)</label><input asp-for="Image" type="file" accept="image/jpeg,image/png" /><span asp-validation-for="Image" class="validation"></span>
@if(!string.IsNullOrEmpty(Model.CurrentImage)) { <img class="preview" src="@Model.CurrentImage" alt="Ảnh hiện tại" /> }
<p><button class="button" type="submit">Lưu sự kiện</button> <a class="button secondary" asp-action="Index">Quay lại</a></p>
