@model RegisterForm
@{ ViewData["Title"]="Đăng ký"; }
<section class="panel auth"><h1>Tạo tài khoản</h1><p class="muted">Đăng ký để tham gia các hoạt động sinh viên.</p>
<form asp-action="Register" method="post" id="register-form"><div asp-validation-summary="All" class="validation"></div>
<label asp-for="FullName">Họ và tên</label><input asp-for="FullName" required maxlength="100" autocomplete="name" /><span asp-validation-for="FullName" class="validation"></span>
<label asp-for="Email">Email</label><input asp-for="Email" type="email" required autocomplete="email" /><span asp-validation-for="Email" class="validation"></span>
<label asp-for="Password">Mật khẩu</label><input asp-for="Password" required minlength="6" autocomplete="new-password" /><small>Ít nhất 6 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.</small><span asp-validation-for="Password" class="validation"></span>
<label asp-for="ConfirmPassword">Xác nhận mật khẩu</label><input asp-for="ConfirmPassword" required autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="validation"></span><p id="password-error" class="validation" role="alert"></p>
<button class="button" type="submit">Đăng ký</button></form><p>Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p></section>
@section Scripts { <script src="~/js/validation.js" asp-append-version="true"></script> }
