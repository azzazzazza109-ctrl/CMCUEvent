@model LoginForm
@{ ViewData["Title"]="Đăng nhập"; }
<section class="panel auth"><h1>Đăng nhập</h1><p class="muted">Chào mừng bạn trở lại CMCU Event.</p>
<form asp-action="Login" method="post"><div asp-validation-summary="All" class="validation"></div><input asp-for="ReturnUrl" type="hidden" />
<label asp-for="Email">Email</label><input asp-for="Email" type="email" required autocomplete="email" /><span asp-validation-for="Email" class="validation"></span>
<label asp-for="Password">Mật khẩu</label><input asp-for="Password" required autocomplete="current-password" /><span asp-validation-for="Password" class="validation"></span>
<button class="button" type="submit">Đăng nhập</button></form><p>Chưa có tài khoản? <a asp-action="Register">Đăng ký</a></p></section>
